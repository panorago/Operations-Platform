# Set in the server process only. Never use a VITE_ prefix for a secret.
ANTHROPIC_API_KEY=
PORT=3001
# Use behind HTTPS in a deployed environment.
COOKIE_SECURE=false
# Optional notification delivery. Recipients are your Finance team, not suppliers.
RESEND_API_KEY=
EMAIL_FROM=
FINANCE_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
FINANCE_PHONE=
# In proxy-backed cloud secrets use the full Basic authorization header here,
# because base64-encoding a proxy placeholder prevents credential injection.
TWILIO_AUTHORIZATION=
# Required for the first administrator setup in a public production deployment.
# Generate a secure setup key on your own server. Never commit it.
SETUP_TOKEN=
